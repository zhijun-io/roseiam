# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# This file is read by two different consumers:
#   - Spring Boot, via `spring.config.import: optional:file:.env[.properties]` in application.yaml
#   - Docker Compose, which picks up .env from the project directory automatically
#
# Spring imports .env as a plain properties file, so these keys arrive LITERALLY
# (SPRING_PROFILES_ACTIVE) rather than being relaxed-bound the way real environment
# variables are. A key only takes effect if application.yaml dereferences it,
# e.g. `server.port: ${SERVER_PORT:8080}`. Adding a new variable here therefore
# means adding a matching placeholder in application.yaml.

# Spring profiles
SPRING_PROFILES_ACTIVE=local

# Local ports (override per Git worktree when needed)
SERVER_PORT=8080
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Isolates container and volume names. Leave it commented out to let Compose derive
# the name from the project directory, which keeps two checkouts of the same project
# (or two generated projects) from colliding. Set it only when you need a stable name.
# COMPOSE_PROJECT_NAME=my-spring-boot-app

# Database (PostgreSQL)
# Compose feeds POSTGRES_PASSWORD from this same variable, so the database and the
# application always agree — change it here and both follow.
POSTGRES_DB=roseiam
POSTGRES_USER=roseiam
POSTGRES_PASSWORD=roseiam-local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:${POSTGRES_PORT}/roseiam
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# Testcontainers reads real environment variables, not this file. To change it,
# export it in your shell: `export TESTCONTAINERS_RYUK_DISABLED=true`
# TESTCONTAINERS_RYUK_DISABLED=false

# Application secrets (NEVER commit real values)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_FRONTEND_BASE_URL=http://localhost:3000
# Required to encrypt SMTP passwords when SMTP auth is enabled; provide 32 random bytes as base64.
APP_SMTP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-secret
APP_BOOTSTRAP_ADMIN_EMAIL=
